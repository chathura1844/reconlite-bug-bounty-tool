def normalize_url_line(line: str) -> str:
    line = line.strip()
    if not line or line.startswith("#"):
        return ""
    match = re.search(r"https?://[^\s'\"<>]+", line)
    if match:
        return match.group(0).rstrip(")],.;")
    return ""


def load_urls_from_file(input_file: str) -> List[str]:
    path = Path(input_file)
    if not path.exists():
        raise FileNotFoundError(f"Input file not found: {input_file}")
    return dedupe([normalize_url_line(line) for line in path.read_text(errors="ignore").splitlines()])


def load_urls_from_stdin() -> List[str]:
    return dedupe([normalize_url_line(line) for line in sys.stdin])


def dedupe(items: List[str]) -> List[str]:
    return list(dict.fromkeys([item for item in items if item]))


def get_params(url: str) -> Set[str]:
    parsed = urlparse(url)
    params = set(parse_qs(parsed.query, keep_blank_values=True).keys())
    return {p.lower() for p in params}


def get_path_tokens(url: str) -> Set[str]:
    parsed = urlparse(url)
    path = parsed.path.lower()
    tokens = set(re.split(r"[^a-zA-Z0-9_.-]+", path))
    return {t for t in tokens if t}


def belongs_to_domain(url: str, domain: str) -> bool:
    if not domain:
        return True
    host = urlparse(url).netloc.lower().split(":")[0]
    domain = domain.lower().strip()
    return host == domain or host.endswith("." + domain)


def classify_url(url: str) -> List[str]:
    params = get_params(url)
    path_tokens = get_path_tokens(url)
    path_full = urlparse(url).path.lower()
    matched = []

    for category, rules in CATEGORIES.items():
        rule_params = set(p.lower() for p in rules["params"])
        rule_paths = set(p.lower() for p in rules["paths"])
        param_match = bool(params.intersection(rule_params))
        path_match = any(token in path_tokens or token in path_full for token in rule_paths)
        if param_match or path_match:
            matched.append(category)

    if urlparse(url).query:
        matched.append(GENERIC_CATEGORY)

    return dedupe(matched)


def classify_urls(urls: List[str], domain: str = "") -> Dict[str, Set[str]]:
    results: Dict[str, Set[str]] = defaultdict(set)
    for url in urls:
        if not belongs_to_domain(url, domain):
            continue
        for category in classify_url(url):
            results[category].add(url)
    return results


def severity_color(severity: str) -> str:
    if severity == "HIGH":
        return Color.RED
    if severity == "MEDIUM":
        return Color.YELLOW
    if severity == "LOW":
        return Color.GREEN
    return Color.BLUE


def category_severity(category: str) -> str:
    if category == GENERIC_CATEGORY:
        return "INFO"
    return CATEGORIES.get(category, {}).get("severity", "INFO")


def category_weight(category: str) -> int:
    if category == GENERIC_CATEGORY:
        return 20
    return int(CATEGORIES.get(category, {}).get("weight", 10))


def category_hint(category: str) -> str:
    if category == GENERIC_CATEGORY:
        return "General parameterized URLs for broad manual review."
    return CATEGORIES.get(category, {}).get("hint", "Manual review recommended.")


def top_priority_urls(results: Dict[str, Set[str]], limit: int = 20) -> List[Tuple[int, str, str]]:
    scored = []
    seen = set()
    for category, urls in results.items():
        if category == GENERIC_CATEGORY:
            continue
        for url in urls:
            key = (url, category)
            if key in seen:
                continue
            seen.add(key)
            score = category_weight(category)
            # Bonus for URLs with multiple query parameters
            params_count = len(get_params(url))
            if params_count >= 2:
                score += 8
            elif params_count == 1:
                score += 4
            scored.append((score, category, url))
    return sorted(scored, key=lambda x: x[0], reverse=True)[:limit]


def write_outputs(results: Dict[str, Set[str]], output_dir: str, total_urls: int, domain: str = "", top_limit: int = 20) -> None:
    out = Path(output_dir)
    out.mkdir(parents=True, exist_ok=True)

    for category, urls in sorted(results.items()):
        file_path = out / f"{category}.txt"
        file_path.write_text("\n".join(sorted(urls)) + "\n", encoding="utf-8")

    top_items = top_priority_urls(results, top_limit)
    (out / "top_priority.txt").write_text("\n".join([f"[{score}] {category} -> {url}" for score, category, url in top_items]) + "\n", encoding="utf-8")

    csv_path = out / "summary.csv"
    with csv_path.open("w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow(["category", "severity", "count", "hint"])
        for category, urls in sorted(results.items(), key=lambda item: len(item[1]), reverse=True):
            writer.writerow([category, category_severity(category), len(urls), category_hint(category)])

    report_path = out / "report.md"
    md = "# ReconLite v2 Report\n\n"
    md += "## Summary\n\n"
    md += f"- Tool version: **{VERSION}**\n"
    md += f"- Author: **{AUTHOR}**\n"
    md += f"- Total URLs loaded: **{total_urls}**\n"
    if domain:
        md += f"- Domain filter: **{domain}**\n"
    md += f"- Categories with matches: **{len(results)}**\n\n"

    md += "## Findings by Category\n\n"
    md += "| Category | Severity | Count | Review Hint |\n"
    md += "|---|---|---:|---|\n"
    for category, urls in sorted(results.items(), key=lambda item: len(item[1]), reverse=True):
        md += f"| `{category}` | **{category_severity(category)}** | {len(urls)} | {category_hint(category)} |\n"

    md += "\n## Top Priority URLs\n\n"
    if top_items:
        md += "| Score | Category | URL |\n|---:|---|---|\n"
        for score, category, url in top_items:
            md += f"| {score} | `{category}` | `{url}` |\n"
    else:
        md += "No priority URLs found.\n"

    md += "\n## Suggested Manual Workflow\n\n"
    md += "1. Start with `top_priority.txt`.\n"
    md += "2. Review `auth_pages.txt` for login, reset, and username enumeration issues.\n"
    md += "3. Review `redirect_candidates.txt` for open redirect and redirect-based XSS.\n"
    md += "4. Review `xss_candidates.txt` for reflected parameters and context.\n"
    md += "5. Review `idor_candidates.txt` only with authorized test accounts.\n"
    md += "6. Review `api_endpoints.txt` for auth, CORS, verbose errors, and schema exposure.\n\n"

    md += "## Safety Note\n\n"
    md += "ReconLite does not exploit targets. It only organizes URLs for ethical manual review within authorized scope.\n"
    report_path.write_text(md, encoding="utf-8")


def print_summary(results: Dict[str, Set[str]], total_urls: int, output_dir: str, no_color: bool = False, top_limit: int = 10) -> None:
    banner(no_color)
    print(c("Category Summary", Color.BOLD, not no_color))
    print("-" * 72)
    print(f"{'Severity':10} {'Category':28} {'Count':>8}  Hint")
    print("-" * 72)

    if not results:
        print(c("No matches found. Try using more URLs from gau/katana/waybackurls.", Color.YELLOW, not no_color))
        return

    for category, urls in sorted(results.items(), key=lambda item: len(item[1]), reverse=True):
        sev = category_severity(category)
        sev_print = c(sev, severity_color(sev), not no_color)
        print(f"{sev_print:18} {category:28} {len(urls):>8}  {category_hint(category)}")

    print("\n" + c("Top Priority URLs", Color.BOLD, not no_color))
    print("-" * 72)
    top_items = top_priority_urls(results, top_limit)
    if not top_items:
        print("No top priority URLs found.")
    else:
        for score, category, url in top_items:
            sev = category_severity(category)
            print(f"[{score:3}] {c(sev, severity_color(sev), not no_color):15} {category:24} {url}")

    print("\n" + c("Output", Color.BOLD, not no_color))
    print("-" * 72)
    print(f"Total URLs loaded : {total_urls}")
    print(f"Output directory  : {output_dir}")
    print(f"Report            : {output_dir}/report.md")
    print(f"Top priorities    : {output_dir}/top_priority.txt")
    print(f"CSV summary       : {output_dir}/summary.csv")
    print(f"Category files    : {output_dir}/*.txt\n")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Classify recon URLs into bug bounty review categories with priority scoring.",
        epilog="Examples:\n"
               "  reconlite -i urls.txt -o recon-output --domain example.com\n"
               "  gau example.com | reconlite -o recon-output --domain example.com\n"
               "  katana -u https://example.com -silent | reconlite -o recon-output\n"
               "  reconlite -i urls.txt --top 30 --no-color",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("-i", "--input", help="Input file containing URLs from gau/katana/waybackurls")
    parser.add_argument("-o", "--output", default="recon-output", help="Output directory")
    parser.add_argument("--domain", help="Optional domain filter, e.g., example.com")
    parser.add_argument("--top", type=int, default=20, help="Number of top priority URLs to save in report")
    parser.add_argument("--no-color", action="store_true", help="Disable colored terminal output")
    parser.add_argument("--version", action="store_true", help="Show ReconLite version")
    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()

    if args.version:
        print(f"ReconLite v{VERSION} by {AUTHOR}")
        return

    try:
        if args.input:
            urls = load_urls_from_file(args.input)
        elif not sys.stdin.isatty():
            urls = load_urls_from_stdin()
        else:
            parser.error("No input provided. Use -i urls.txt or pipe URLs into reconlite.")
            return

        results = classify_urls(urls, args.domain or "")
        write_outputs(results, args.output, len(urls), args.domain or "", args.top)
        print_summary(results, len(urls), args.output, args.no_color, min(args.top, 10))

    except BrokenPipeError:
        return
    except Exception as error:
        print(f"[ERROR] {error}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()

